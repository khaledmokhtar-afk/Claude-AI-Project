{
  "name": "iesl-ai-suite",
  "private": true,
  "version": "0.1.0",
  "description": "IESL AI Suite — RiskLens, ScopeSmith, and EstimatorAI unified in a single Next.js app with shared Claude AI Mode.",
  "scripts": {
    "dev": "pnpm --filter iesl-hub dev",
    "dev:hub": "pnpm --filter iesl-hub dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter iesl-hub start",
    "lint": "pnpm --filter iesl-hub lint",
    "clean": "rm -rf apps/*/.next apps/*/node_modules packages/*/node_modules node_modules"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
