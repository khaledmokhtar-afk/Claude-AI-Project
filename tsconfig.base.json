{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@iesl/ai": ["./packages/ai/src/index.ts"],
      "@iesl/ai/*": ["./packages/ai/src/*"],
      "@iesl/ui": ["./packages/ui/src/index.ts"],
      "@iesl/ui/*": ["./packages/ui/src/*"],
      "@iesl/data": ["./packages/data/src/index.ts"],
      "@iesl/data/*": ["./packages/data/src/*"],
      "@iesl/charts": ["./packages/charts/src/index.ts"],
      "@iesl/charts/*": ["./packages/charts/src/*"]
    }
  }
}
